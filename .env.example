STT_HOST=0.0.0.0
STT_PORT=23000
# 文字起こしエンジン: whisper | haas（haas は uv sync --extra haas が必要。日本語専用・NVIDIA GPU 専用）
STT_BACKEND=whisper
# --- whisper 用 ---
STT_MODEL=large-v3-turbo
# cuda | cpu | auto
STT_DEVICE=auto
# int8, int8_float16, float16, float32
STT_COMPUTE_TYPE=int8_float16
# --- haas 用 ---
STT_HAAS_MODEL=third-intelligence/Haas-ja-v1.0
# --- 共通 ---
STT_LANGUAGE=ja
# Bearer認証トークン（空にすると認証スキップ）
STT_API_KEY=
