STT_HOST=0.0.0.0
STT_PORT=23000
# 文字起こしエンジン: whisper | haas（haas は uv sync --extra haas が必要。日本語専用・NVIDIA GPU 専用）
STT_BACKEND=whisper
# --- whisper 用 ---
STT_MODEL=large-v3-turbo
# cuda | cpu | auto
STT_DEVICE=auto
# int8, int8_float16, float16, float32
STT_COMPUTE_TYPE=int8_float16
# --- haas 用 ---
STT_HAAS_MODEL=third-intelligence/Haas-ja-v1.0
# --- 共通 ---
STT_LANGUAGE=ja
# Bearer認証トークン（空にすると認証スキップ）
STT_API_KEY=
# --- 並列処理 ---
# ワーカープロセス数。ワーカーごとにモデルを読み込むため、GPU メモリもその数だけ必要
STT_WORKERS=1
# 1 ワーカーがこの件数のリクエスト（/health を含む）を処理したら入れ替える。0 で無効
STT_MAX_REQUESTS=0
# 入れ替えまでの件数を、ワーカーごとに 0〜この値だけずらす
STT_MAX_REQUESTS_JITTER=0
# --- /stream ---
# 1 発話の音声の上限（秒）
STT_STREAM_MAX_UTTERANCE_SECONDS=60
# 1 ワーカーで同時に相槌を出せる発話の数（1 発話あたり CPU 約 1.4 コア）。超えた発話は相槌なし
STT_BACKCHANNEL_MAX_SESSIONS=4
# 相槌を出す確率のしきい値（0 より大きく 1 以下）。小さいほど相槌が増える
STT_BACKCHANNEL_THRESHOLD=0.5
# 相槌と相槌の最短の間隔（ミリ秒）
STT_BACKCHANNEL_MIN_INTERVAL_MS=1500
# 相槌の文言（カンマ区切り）
STT_BACKCHANNEL_PHRASES=うん,うんうん,はい,なるほど
# 一時的な返事を作る Ollama とモデル
STT_ACK_OLLAMA_URL=http://127.0.0.1:11434
STT_ACK_MODEL=gemma4:e2b
# 一時的な返事を待つ上限（ミリ秒）と文字数の上限
STT_ACK_TIMEOUT_MS=1500
STT_ACK_MAX_CHARS=20
# 一時的な返事を作れなかったときの文言
STT_ACK_FALLBACK_TEXT=ちょっと確認するね。
# Ollama がモデルを GPU に置いておく時間
STT_ACK_KEEP_ALIVE=30m
