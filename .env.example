STT_HOST=0.0.0.0
STT_PORT=23000
# 文字起こしエンジン: whisper | haas（haas は uv sync --extra haas が必要。日本語専用・NVIDIA GPU 専用）
STT_BACKEND=whisper
# リクエストで選べるエンジン（カンマ区切り。STT_BACKEND を含める）。空なら STT_BACKEND だけ
# STT_BACKEND 以外のモデルは、初めて指定されたときに読み込む
STT_ENABLED_BACKENDS=
# --- whisper 用 ---
STT_MODEL=large-v3-turbo
# cuda | cpu | auto
STT_DEVICE=auto
# int8, int8_float16, float16, float32
STT_COMPUTE_TYPE=int8_float16
# --- haas 用 ---
STT_HAAS_MODEL=third-intelligence/Haas-ja-v1.0
# --- 共通 ---
STT_LANGUAGE=ja
# Bearer 認証トークン。空にするとトークンの値を検証しない（Authorization ヘッダは必要）
STT_API_KEY=
# --- 並列処理 ---
# ワーカープロセス数。ワーカーごとにモデルを読み込むため、GPU メモリもその数だけ必要
STT_WORKERS=1
# 1 ワーカーがこの件数のリクエスト（/health を含む）を処理したら入れ替える。0 で無効
STT_MAX_REQUESTS=0
# 入れ替えまでの件数を、ワーカーごとに 0〜この値だけずらす
STT_MAX_REQUESTS_JITTER=0
# --- /stream ---
# 1 発話の音声の上限（秒）
STT_STREAM_MAX_UTTERANCE_SECONDS=60
# 相槌の調整用に、発話の音声と相槌の判定の記録を保存するディレクトリ。空なら保存しない
STT_STREAM_RECORDING_DIR=
# 1 ワーカーで同時に相槌を出せる発話の数。超えた発話は相槌なし
STT_BACKCHANNEL_MAX_SESSIONS=4
# 相槌を出すまでに待つ無音の長さ（ミリ秒、32 以上）
STT_BACKCHANNEL_SILENCE_MS=90
# 前の相槌（無ければ話し始め）から新しくこの長さ話すまで相槌を出さない（ミリ秒）
STT_BACKCHANNEL_MIN_NEW_SPEECH_MS=1000
# 相槌と相槌の最短の間隔（ミリ秒）。話し始めの間隔で、話が続くほど・相槌を重ねるほど下の設定で伸びる
STT_BACKCHANNEL_MIN_INTERVAL_MS=1500
# 1 分話すごとに最短の間隔へ足す長さ（ミリ秒）
STT_BACKCHANNEL_INTERVAL_PER_MINUTE_MS=3000
# 相槌を 1 回出すごとに最短の間隔を何倍にするか（1.0〜3.0）
STT_BACKCHANNEL_INTERVAL_FACTOR=1.1
# 伸ばした最短の間隔の上限（ミリ秒）
STT_BACKCHANNEL_MAX_INTERVAL_MS=8000
# 言いかけの途中で相槌を出さないために使う言語モデル（Hugging Face のモデル名か、モデルのディレクトリ）。
# 空なら判定しない。extras haas が必要で、GPU を約 1.5GB 使う（例: Qwen/Qwen3.5-0.8B-Base）
STT_BACKCHANNEL_BOUNDARY_MODEL=
# 相槌を出す「言い終わりの区切りらしさ」の下限（0〜1）。大きいほど相槌が減る。0 で判定しない
STT_BACKCHANNEL_BOUNDARY_THRESHOLD=0.35
# 区切りの判定（途中の文字起こしを含む）を待つ上限（ミリ秒）。間に合わなければその相槌は出さない
STT_BACKCHANNEL_JUDGE_TIMEOUT_MS=200
# 相槌の文言（カンマ区切り）
STT_BACKCHANNEL_PHRASES=うん,うんうん,はい,なるほど
# 一時的な返事を作る Ollama とモデル
STT_ACK_OLLAMA_URL=http://127.0.0.1:11434
STT_ACK_MODEL=gemma4:e2b
# 一時的な返事を待つ上限（ミリ秒）と文字数の上限
STT_ACK_TIMEOUT_MS=1500
STT_ACK_MAX_CHARS=20
# 一時的な返事を作れなかったときの文言
STT_ACK_FALLBACK_TEXT=ちょっと確認するね。
# Ollama がモデルを GPU に置いておく時間
STT_ACK_KEEP_ALIVE=30m
