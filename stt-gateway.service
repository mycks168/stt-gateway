[Unit]
Description=STT Gateway (faster-whisper / Haas-ja)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/stt-gateway
EnvironmentFile=-/opt/stt-gateway/.env
ExecStart=/bin/bash scripts/run_server.sh
# STT_MAX_REQUESTS でワーカー 1 つのプロセスが正常終了したときも起動し直すため always にする。
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
